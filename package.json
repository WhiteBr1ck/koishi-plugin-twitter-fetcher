{
  "name": "koishi-plugin-twitter-fetcher",
  "description": "一个推特/Twitter/X内容获取与订阅插件，支持链接解析、用户订阅和话题标签订阅。",
  "version": "2.1.0",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "lib",
    "dist",
    "client"
  ],
  "author": "whitebr1ck",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WhiteBr1ck/koishi-plugin-twitter-fetcher.git"
  },
  "bugs": {
    "url": "https://github.com/WhiteBr1ck/koishi-plugin-twitter-fetcher/issues"
  },
  "homepage": "https://github.com/WhiteBr1ck/koishi-plugin-twitter-fetcher#readme",
  "keywords": [
    "koishi",
    "plugin",
    "twitter",
    "x",
    "fetcher",
    "parse",
    "resolver",
    "subscribe",
    "subscription",
    "hashtag",
    "push",
    "gif",
    "ffmpeg",
    "browser"
  ],
  "peerDependencies": {
    "@koishijs/plugin-console": "^5.30.0",
    "koishi": "^4.18.7",
    "koishi-plugin-chatluna": "^1.3.0",
    "koishi-plugin-ffmpeg": "^1.1.0",
    "koishi-plugin-puppeteer": "*"
  },
  "koishi": {
    "description": {
      "zh": "自动解析推特/Twitter/X链接，支持用户与话题标签订阅、浏览器原生获取、翻译、真 GIF 和多种媒体发送方式。"
    },
    "service": {
      "required": [
        "puppeteer",
        "database"
      ],
      "optional": [
        "console",
        "ffmpeg",
        "chatluna"
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node18 --external:koishi --external:koishi-plugin-puppeteer --external:@koishijs/plugin-console --external:koishi-plugin-chatluna/* --external:@the-convocation/twitter-scraper --outfile=lib/index.js && tsc --emitDeclarationOnly",
    "build:client": "node -e \"import('@koishijs/client/lib').then(({ build }) => build(process.cwd()))\""
  },
  "dependencies": {
    "@the-convocation/twitter-scraper": "0.22.3"
  },
  "devDependencies": {
    "@koishijs/client": "^5.30.4"
  },
  "peerDependenciesMeta": {
    "@koishijs/plugin-console": {
      "optional": true
    },
    "koishi-plugin-chatluna": {
      "optional": true
    },
    "koishi-plugin-ffmpeg": {
      "optional": true
    }
  }
}
